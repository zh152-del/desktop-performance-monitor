<?xml version="1.0" encoding="utf-8"?>
<!--
  说明：本项目【不使用 NuGet 还原】，packages 目录里的 DLL 已经提交进仓库，
  csproj 用 HintPath 直接引用，clone 下来就能离线编译。
  这个文件只是记录一下这些 DLL 的来源版本，不参与构建。
-->
<packages>
  <!-- 2026-09-15: 0.9.4 -> 0.9.6，因为 0.9.4 的 WinRing0 驱动是 CVE-2020-14979，会被火绒/Defender 拦 -->
  <package id="LibreHardwareMonitorLib" version="0.9.6" targetFramework="net48" />
  <package id="HidSharp" version="2.6.4" targetFramework="net48" />
  <package id="BlackSharp.Core" version="1.0.7" targetFramework="net48" />
  <package id="DiskInfoToolkit" version="1.1.2" targetFramework="net48" />
  <package id="RAMSPDToolkit-NDD" version="1.4.2" targetFramework="net48" />
  <package id="System.Memory" version="4.5.5" targetFramework="net48" />
  <package id="System.Buffers" version="4.5.1" targetFramework="net48" />
  <package id="System.Numerics.Vectors" version="4.5.0" targetFramework="net48" />
  <package id="System.Runtime.CompilerServices.Unsafe" version="6.0.3" targetFramework="net48" />
</packages>
