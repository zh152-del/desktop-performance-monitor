<Application x:Class="PerfMonitorWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ============================================================
             色令牌（2026-10-24 第四轮：深色金属 DarkMetal v1.0）
             底材质改为金属板后，内容配色按规范 4.4「内容配色映射」重新取值；
             强调色（青/蓝/紫）与告警色（橙/红）只表达数据语义，不参与材质。
             ============================================================ -->
        <SolidColorBrush x:Key="TextPrimary"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecond"    Color="#9AA5B4"/>
        <SolidColorBrush x:Key="TextDim"       Color="#6B7686"/>

        <SolidColorBrush x:Key="AccentCyan"    Color="#55C6D4"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#7DA8EA"/>
        <SolidColorBrush x:Key="AccentPurple"  Color="#9D8DF1"/>
        <SolidColorBrush x:Key="WarnOrange"    Color="#D9AD6D"/>
        <SolidColorBrush x:Key="DangerRed"     Color="#D97C85"/>
        <!-- 硬件卡片大环专用绿（≤55% 利用率）。低饱和，与 DangerRed 同一亮度层级；
             只服务顶部三张卡片，不改其他模块配色。 -->
        <SolidColorBrush x:Key="RingGreen"     Color="#63BE8C"/>

        <!-- 轨道：规范 4.4 —— 15% 白，在金属板上「看得见但不抢数据」 -->
        <SolidColorBrush x:Key="RingTrack"     Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="BarTrack"      Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush"  Color="#1FFFFFFF"/>

        <!-- ============================================================
             深色金属材质画刷（DarkMetal v1.0 · L1 / L2 / L3 / L5）
             参数严格取自规范第 4 节参数总表；
             L4 微表面噪声由 MetalMaterial.cs 运行时生成（WriteableBitmap
             无法写成静态资源），层结构见 MainWindow.xaml 的 MetalLayer。
             ============================================================ -->

        <!-- L1 金属基底：135° 对角渐变，左上偏冷枪灰 → 右下略亮，给出光的方向
             alpha 取规范 §4.5 的 88% 档（#E0）：等效不透明度约 90%，
             壁纸只透 10%，不会在面板上糊一层雾；再实就换 96% 档 #F5。
             色相微调：蓝通道在原值基础上各 +2（#1A1D22→#1A1D24、#23272F→#232731），
             红绿不动。目的只是把整块面板相对隔壁那一点点偏暖压掉，肉眼几乎看不出单像素差异。 -->
        <LinearGradientBrush x:Key="MetalBaseBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0141820" Offset="0"/>
            <GradientStop Color="#E01C222E" Offset="1"/>
        </LinearGradientBrush>

        <!-- L2 中央暗区：径向暗化，中心略偏上 (50%,38%)，覆盖 75%×80%，制造凹面纵深
             暗区 alpha 必须与基底同档缩放（规范 §4.5）：88% 档 = #91 -->
        <RadialGradientBrush x:Key="MetalVignetteBrush"
                             Center="0.5,0.38" GradientOrigin="0.5,0.38"
                             RadiusX="0.75" RadiusY="0.8">
            <GradientStop Color="#910B0D12" Offset="0"/>
            <GradientStop Color="#000B0D10" Offset="1"/>
        </RadialGradientBrush>

        <!-- L3 暖色球体：琥珀，峰值 alpha 由规范的 0.22 降到 0.18（左上）。
             规范要求三点光源必须都在，所以保留这一盏，只把强度收一档——
             它是整块面板"偏暖"最明显的一处（170×120 的琥珀光斑压在左上角）。 -->
        <RadialGradientBrush x:Key="ReflectWarmBrush"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3DF2C8A0" Offset="0"/>
            <GradientStop Color="#22F2C8A0" Offset="0.45"/>
            <GradientStop Color="#00F2C08A" Offset="1"/>
        </RadialGradientBrush>

        <!-- L3 冷色板面：冷蓝，峰值 alpha 0.17（右下） -->
        <RadialGradientBrush x:Key="ReflectCoolBrush"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#338FB0D9" Offset="0"/>
            <GradientStop Color="#178FB0D9" Offset="0.5"/>
            <GradientStop Color="#007FA6C9" Offset="1"/>
        </RadialGradientBrush>

        <!-- L3 白色灯条：上缘，峰值 alpha 0.11，两端透明（倾斜角在 XAML 里给） -->
        <LinearGradientBrush x:Key="ReflectStripBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#2EFFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- L5 外缘亮线：左上强 → 中间弱 → 右下回亮（模拟棱边反光不均） -->
        <LinearGradientBrush x:Key="MetalEdgeOuterBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#73FFFFFF" Offset="0"/>
            <GradientStop Color="#26FFFFFF" Offset="0.5"/>
            <GradientStop Color="#4DFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- L5 内缘暗线：上亮下暗，形成内斜面 -->
        <LinearGradientBrush x:Key="MetalEdgeInnerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#1A000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================================
             表面与边界（功能单元体系，规范 4.4）
             卡片面 = 4~6% 白，悬停 = 8% 白；边框 12% 白，悬停提亮到 25% 白。
             在金属板上靠「白色半透明层 + 亮边框」区分层次，不再用不透明的近黑面。
             ============================================================ -->
        <SolidColorBrush x:Key="CardSurface"     Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="CardSurfaceHot"  Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="RowHot"          Color="#1AFFFFFF"/>

        <SolidColorBrush x:Key="Edge"            Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="EdgeHover"       Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="EdgeSoft"        Color="#14FFFFFF"/>

        <!-- 子项卡片的边缘光：沿用面板倒角的思路（左上强 → 中间弱 → 右下回亮），
             1px 渐变描边，让每张卡从金属底上「立」起来。
             只是提亮描边本身，不动卡片底色，避免又叠出一层暖调/雾感。 -->
        <!-- 色差描边：R/B 双通道错位 0.5~1.5px（对应 liquid-glass 的 aberrationIntensity=2） -->
        <SolidColorBrush x:Key="LiquidChromaWarmBrush" Color="#2AFF7A7A"/>
        <SolidColorBrush x:Key="LiquidChromaCoolBrush" Color="#2A7A8CFF"/>

        <LinearGradientBrush x:Key="CardEdgeLight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#80FFFFFF" Offset="0"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.45"/>
            <GradientStop Color="#47FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardEdgeLightHot" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8FFFFFF" Offset="0"/>
            <GradientStop Color="#33FFFFFF" Offset="0.45"/>
            <GradientStop Color="#66FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- 浮层（设置 / 电源 / 确认）必须能压住下面的金属板，保持近黑不透明 -->
        <SolidColorBrush x:Key="OverlayPanel"    Color="#F20A0D10"/>
        <SolidColorBrush x:Key="OverlayEdge"     Color="#33FFFFFF"/>

        <!-- 设置面板用的中性表面 -->
        <SolidColorBrush x:Key="Surface"         Color="#10151D"/>
        <SolidColorBrush x:Key="SurfaceHover"    Color="#171E28"/>
        <SolidColorBrush x:Key="SurfaceActive"   Color="#1C2431"/>
        <SolidColorBrush x:Key="SurfacePressed"  Color="#0D1219"/>
        <SolidColorBrush x:Key="SurfaceAccent"   Color="#16232C"/>

        <!-- ============================================================
             功能单元（HoverCard）：圆角 + 细边框 + 深色半透明面
             悬停：边框提亮 / 表面提亮 / 整体放大 1.02（RenderTransform，
                    不参与布局测量，不会挤压相邻元素）
             缩放动画 120ms 进入、140ms 还原，无常驻动画。
             ============================================================ -->
        <Style x:Key="HoverCard" TargetType="ContentControl">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="{StaticResource CardSurface}"/>
            <!-- 边缘光：左上亮、中间弱、右下回亮，替代原来那圈均匀的 12% 白细线 -->
            <Setter Property="BorderBrush" Value="{StaticResource CardEdgeLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="cardScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CardEdgeLightHot}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardSurfaceHot}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="cardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="cardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 同一外观但不带悬停缩放：用于「内部还有会悬起的子元素」的容器，
             避免父容器和子元素同时放大造成双重缩放 -->
        <Style x:Key="CardStatic" TargetType="ContentControl" BasedOn="{StaticResource HoverCard}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 轻量行：剪贴板每条记录。只做边框提亮，不缩放（18px 的行缩放也看不出来） -->
        <Style x:Key="RowHover" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource EdgeHover}"/>
                    <Setter Property="Background" Value="{StaticResource RowHot}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================
             1px 横向分隔线：只在必要时使用，低对比度
             ============================================================ -->
        <Style x:Key="HDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- ============================================================
             轻量小按钮：剪贴板的「检测」「复制」
             ============================================================ -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4"
                                Background="{StaticResource CardSurface}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="7,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardSurfaceHot}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EdgeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             底部四个操作入口：扁平、轻量、圆角细边框
             ============================================================ -->
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{StaticResource CardSurface}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardSurfaceHot}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EdgeHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 电源：仅文字用危险色，不做大面积刺眼红块 -->
        <Style x:Key="BarBtnDanger" TargetType="Button" BasedOn="{StaticResource BarBtn}">
            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
        </Style>

        <!-- 浮层上的菜单按钮 -->
        <Style x:Key="OvBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Edge}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 确认浮层里的两个按钮 -->
        <Style x:Key="OvActionBtn" TargetType="Button" BasedOn="{StaticResource OvBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{StaticResource CardSurface}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardSurfaceHot}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EdgeHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             设置面板：分段选择按钮
             ============================================================ -->
        <Style x:Key="SegBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="4"
                                Background="{StaticResource CardSurface}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="7,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardSurfaceHot}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EdgeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAccent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             设置面板：开关
             ============================================================ -->
        <Style x:Key="SwitchBox" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="{StaticResource CardSurface}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="knob" Width="12" Height="12"
                                         Fill="#748194"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EdgeHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAccent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{StaticResource AccentCyan}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             设置面板：整行动作按钮
             ============================================================ -->
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="8,0">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <TextBlock x:Name="arrow" Text="›" FontSize="13"
                                           Foreground="#748194"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Edge}"/>
                                <Setter TargetName="arrow" Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 同一套样式但危险色（退出程序） -->
        <Style x:Key="RowBtnDanger" TargetType="Button" BasedOn="{StaticResource RowBtn}">
            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
        </Style>

        <!-- ============================================================
             设置面板：细分隔线（仅分组之间）
             ============================================================ -->
        <Style x:Key="SettingDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1C2431"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ============================================================
             细滚动条
             ============================================================ -->
        <Style x:Key="ThinScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#3A4655"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
